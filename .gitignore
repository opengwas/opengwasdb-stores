# Raw GWAS Catalog source data (100+ MB); source data lives outside the repo
# and is referenced by URI (see README). Download separately into resources/data/.
resources/data/*.tsv
resources/cache/

# Generated by resources/scripts/ebi-studies.r; regenerate rather than commit.
resources/data/derived/

# Rendered Quarto output; regenerate with `quarto render resources/scripts/*.qmd`.
resources/scripts/*.html
resources/scripts/*_files/
resources/scripts/*_cache/
resources/scripts/.quarto/

# Large downloaded summary statistics used by mvp-imputation-filters.qmd.
resources/data/mvp-example/

# Ragged-store spike: transient downloads + filtered outputs (regenerate).
resources/data/ragged-spike/

# Generated ragged GWAS-SSF filtered files and built stores.
resources/data/gwas-ssf-ragged/

# Built OpenGWASDB store from the no-cis-region-policy fixture's build-store.py
# smoke test (issue #101 follow-up); regenerated fresh each test run.
tests/no-cis-region-policy/fixtures/output/store/

# Smoke-test sidecars from partial generator runs.
families/*/releases/*/sidecars/*.partial.tsv

__pycache__/

# Pixi-managed environments/cache (issue #41): reproduced from pixi.toml +
# pixi.lock, never committed.
.pixi/
*.egg-info/

# Local secrets (e.g. OPENGWAS_JWT for resources/lib/metadata_resolvers/
# opengwas_api.R's fetch_opengwas_gwasinfo()); never committed.
.Renviron
.env
# Throwaway workflow-prototype runtime state.
.prototype-state/
.snakemake/

# Per-run outputs of the LD-panel eigendecomposition suite (the committed
# fixtures are the sequential .ldeig.npz; -par/-seq are comparison artifacts).
tests/ld-panel-eigendecomposition/fixtures/panel/**/*.ldeig-par.npz
tests/ld-panel-eigendecomposition/fixtures/panel/**/*.ldeig-seq.npz

# Test-suite outputs (issue #125).
#
# These are written by each suite's own `generate_fixtures` script on every run,
# which unlinks and rewrites them, so the committed copies were destroyed before
# they could ever be read. Tracking them meant every test run dirtied the working
# tree, which would make the "regenerate and fail on a dirty tree" CI gates in
# #124 and #131 flaky.
#
# Only the generated files are listed. The generator scripts, configs,
# candidates tables, `source/` and `reference-af/` inputs stay tracked -- and so
# do `release/build.yaml` and `release/release.yaml`, which sit alongside
# generated files in the same directory but are inputs.
tests/ancestry-assignment/fixtures/reference/ref_freqs.hg38.tsv.gz
tests/ancestry-assignment/fixtures/release/filtered/
tests/effect-scale-validation/fixtures/release/analyses.tsv
tests/effect-scale-validation/fixtures/release/validation.yaml
tests/effect-scale-validation/fixtures/release/filtered/
tests/effect-scale-validation/fixtures/release/sidecars/
tests/ld-panel-eigendecomposition/fixtures/panel/
tests/no-cis-region-policy/fixtures/output/
tests/qc-panel-retention/fixtures/output-with-panel/
tests/qc-panel-retention/fixtures/output-without-panel/
