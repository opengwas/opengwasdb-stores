"""Phase A: every buildable Release Bundle in stores/, wired by dependency only.

    pixi run release OGS-00003             one release, plus any parent it needs
    pixi run release OGS-00003 OGS-00004   several; lineage order is resolved
    pixi run index                         regenerate master list and summaries

One Snakefile for the whole registry rather than one per release, so
Snakemake's own wildcard expansion is the multi-release runner and a
Reference-Completed release can declare its parent's `register` record as a
real input edge. A batch loop would have to sequence parents before children
by hand.

Per ADR 0023 this file contains no source column name,
no manifest translation, and no layout branch. It asks `ogstores.plan` for the
Step list and hands each Step to `ogstores.run`; the tracked output is always
that step's record file, never the Store directory -- a half-written Store
must not satisfy a rule. It also materialises the derived build manifest by
calling `ogstores.manifest`; it carries no filtering logic itself (ADR 0025).

    build_manifest --> build (or complete) --> top_hits --> rho --> overview --> validate --> register

A release that completes its own Store (ADR 0037) then runs its completion
phase from that `register` record:

    register --> complete --> completion-rho --> completion-overview --> completion-validate
        --> completion-observed-view-check --> completion-register

The `build_manifest` rule feeds every build-phase command: `plan()` resolves
the `analyses` token to the derived path `<artifact-root>/<store_id>/work/
analyses.tsv`, which is the first planned step's input, so Snakemake builds the
filtered manifest before the builder sees it. Completion commands read only
their parent Store, so they depend on no manifest step.

Post-steps exist only when supported by the selected command: notably, Ragged
Store envelopes exclude overview.html, so Ragged plans go directly to validate
after their final supported index step.

Every execution step is one rule over a `{step}` wildcard, because the rules
differed only in which name they looked up. The chain's shape lives in
`plan()`, so `step_input` reads the planned order rather than restating it.
"""

from __future__ import annotations

import os
from pathlib import Path

from snakemake.exceptions import WorkflowError

# `ogstores` is installed editable into the pixi environment (#257).
from ogstores import amendment, bundle, index, manifest, paths, register, resources, run, runtime
from ogstores.plan import (
    BUILD_PHASE,
    COMPLETION_PHASE,
    OBSERVED_VIEW_CHECK_STEP,
    REGISTER_STEPS,
    completion_step_name,
    plan,
    release_register,
)

REGISTRY_ROOT: Path = Path(config.get("registry_root", "stores"))
if not REGISTRY_ROOT.is_dir() and (Path.cwd() / "stores").is_dir():
    REGISTRY_ROOT = Path.cwd() / "stores"

ALL_STORE_IDS: list[str] = sorted([
    d.name for d in REGISTRY_ROOT.iterdir()
    if d.is_dir() and paths.is_valid_store_id(d.name) and (d / "release.yaml").is_file()
]) if REGISTRY_ROOT.is_dir() else []

EXECUTION_STEPS = ["variant-reference", "build", "complete", "top-hits", "rho", "overview", "validate"]
# Declared Indexed Variant Subsets (#209) add one dynamically named step per
# declaration, `indexed-subset-<name>`, so the `{step}` wildcard admits that
# bounded prefix in addition to the fixed execution steps.
INDEXED_SUBSET_STEP_PATTERN = "indexed-subset-[A-Za-z0-9._-]+"
# A release that completes its own Store (ADR 0037) records its completion
# phase's post steps as `completion-<step>`, apart from its build phase's.
# Its first step is `complete`, and its register is a rule of its own.
COMPLETION_STEPS = [
    *(completion_step_name(name) for name in ("rho", "overview", "validate")),
    OBSERVED_VIEW_CHECK_STEP,
]
COMPLETION_SUBSET_STEP_PATTERN = completion_step_name(INDEXED_SUBSET_STEP_PATTERN)


def get_bundle(store_id: str) -> bundle.Bundle:
    """Load bundle for store_id from active REGISTRY_ROOT."""
    return bundle.load(store_id, registry_root=REGISTRY_ROOT)


def get_artifact_root() -> Path:
    """Resolve the artifact root from configuration, never from a Build Recipe.

    Precedence is the workflow `--config artifact_root=`, the
    `OPENGWASDB_ARTIFACT_ROOT` environment variable, the repository
    `ogstores.yaml`, then the built-in default (issue #126).
    """
    return paths.artifact_root(config.get("artifact_root"))


def get_steps(store_id: str, root: Path | str | None = None):
    """Derive the planned Step list for store_id without layout branching (ADR 0023)."""
    return plan(get_bundle(store_id), artifact_root=root or get_artifact_root())


def record(store_id: str, step: str, root: Path | str | None = None) -> str:
    """Tracked record file for one step of one release."""
    return str(paths.record_path(store_id, step, root=root or get_artifact_root()))


def step_input(wildcards) -> list[str]:
    """Predecessor of a step: the prior record, a register record, or raw sources.

    The first planned step of a derived release takes its parent's `register`
    record, which is what sequences a lineage without a hand-written batch order.
    The first step of a completion phase takes its own build phase's `register`
    record, because it completes the Store that phase published (ADR 0037).
    """
    steps = get_steps(wildcards.store_id, wildcards.root)
    names = [s.name for s in steps]
    idx = names.index(wildcards.step)
    if idx > 0 and steps[idx - 1].phase == steps[idx].phase:
        return [record(wildcards.store_id, names[idx - 1], wildcards.root)]
    if idx > 0:
        return [record(wildcards.store_id, REGISTER_STEPS[steps[idx - 1].phase], wildcards.root)]

    parent = get_bundle(wildcards.store_id).derived_from
    if parent:
        return [record(parent, "register", wildcards.root)]
    return [str(p) for p in steps[0].inputs]


def stage_column_map(store_id: str, destination: Path) -> None:
    """Stage a release's carried Column Map, or refuse naming it (#292).

    A function and not inline in the rule: `resources` is a Snakemake keyword
    inside a rule's `run:`, and shadows the module there.
    """
    try:
        resources.stage_column_map(get_bundle(store_id), destination)
    except resources.ReferenceResourceError as exc:
        raise WorkflowError(str(exc))


def check_staged_column_map(store_id: str, root: str, inputs) -> None:
    """Refuse a step whose staged Column Map is not the bound one, naming it (#292)."""
    try:
        resources.verify_staged_column_map(get_bundle(store_id), root, inputs)
    except resources.ReferenceResourceError as exc:
        raise WorkflowError(str(exc))


def last_step_record(wildcards, phase: str) -> str:
    """The record a phase's register consumes: the phase's last planned step's."""
    names = [s.name for s in get_steps(wildcards.store_id, wildcards.root) if s.phase == phase]
    if not names:
        raise WorkflowError(f"{wildcards.store_id} has no {phase} phase to register")
    return record(wildcards.store_id, names[-1], wildcards.root)


wildcard_constraints:
    root=".+",
    store_id=r"OGS-\d{5}",
    file=r"[^/]+\.toml",
    step="|".join([
        *EXECUTION_STEPS,
        INDEXED_SUBSET_STEP_PATTERN,
        *COMPLETION_STEPS,
        COMPLETION_SUBSET_STEP_PATTERN,
    ])


onstart:
    # Defence in depth for a direct `snakemake` run. The supported entry point,
    # `pixi run release` (workflow/release.py), refuses, snapshots and settles
    # around Snakemake and cannot be switched off. Here, before the first job,
    # a run that would build a bundle whose Release Status does not allow it is
    # refused (#247), and so is one that would rebuild a published release
    # unless it holds the records snapshot of the entry point's run,
    # `release_run` (#195).
    scheduled = [
        (job.wildcards_dict["root"], job.wildcards_dict["store_id"])
        for job in workflow.dag.needrun_jobs()
        if {"root", "store_id"} <= job.wildcards_dict.keys()
    ]
    # Same jobs with the `step` wildcard, for the runtime guard's parent-format
    # and capability checks: an enhancement-only job on a Store is not a build
    # of that Store (#218).
    scheduled_jobs = [
        (
            job.wildcards_dict["root"],
            job.wildcards_dict["store_id"],
            job.wildcards_dict.get("step"),
        )
        for job in workflow.dag.needrun_jobs()
        if {"root", "store_id"} <= job.wildcards_dict.keys()
    ]
    # Release Status first: a named candidate, or the unbuilt parent a named
    # child would schedule, is refused before any other check (#247).
    try:
        bundle.refuse_unbuildable(
            get_bundle(store_id) for store_id in sorted({sid for _, sid in scheduled})
        )
    except bundle.NotBuildableError as exc:
        raise WorkflowError(str(exc))
    # A bundle that completes its own Store and no longer plans the Store it
    # published is refused, unless forced, beyond the one amendment ADR 0037
    # allows: gaining a `complete` block (#305).
    try:
        amendment.refuse_changed_bundles(
            sorted({sid for _, sid in scheduled}),
            registry_root=REGISTRY_ROOT,
            artifact_root=get_artifact_root(),
            forced=run.forced_by_transaction(config.get("release_run"), scheduled),
        )
    except amendment.AmendmentError as exc:
        raise WorkflowError(str(exc))
    # Completion-phase jobs over the release's own published Observed-Only
    # Store are its next step, not a rebuild of it (#305, ADR 0037).
    run.refuse_rebuilding_published_releases(
        scheduled,
        forced=run.forced_by_transaction(config.get("release_run"), scheduled),
        completing=run.completing_own_stores(
            [
                (
                    job.wildcards_dict["root"],
                    job.wildcards_dict["store_id"],
                    run.job_record(job.rule.name, job.wildcards_dict.get("step")),
                )
                for job in workflow.dag.needrun_jobs()
                if {"root", "store_id"} <= job.wildcards_dict.keys()
            ],
            registry_root=REGISTRY_ROOT,
        ),
    )
    # Defence in depth for a direct `snakemake` run (#218): the resolved
    # runtime must be the tracked pin, provide every capability the scheduled
    # steps name, and be able to complete each parent a scheduled completion
    # consumes. Refuse before the first job writes a Store. Under the entry
    # point, the subcommands it has just probed on this runtime are not probed
    # again; the pin is checked either way.
    try:
        runtime.verify_runtime_for_releases(
            scheduled_jobs,
            registry_root=REGISTRY_ROOT,
            handoff=os.environ.get(runtime.VERIFIED_RUNTIME_ENV),
        )
    except runtime.RuntimeGuardError as exc:
        raise WorkflowError(str(exc))
    # Defence in depth for a direct `snakemake` run (#209): a declared Indexed
    # Variant Subset needs a `build-indexed-subset`-capable runtime and a
    # maintained variant list that matches its declaration. Refuse before the
    # build starts rather than hours in.
    try:
        resources.verify_indexed_subsets_for_releases(scheduled, registry_root=REGISTRY_ROOT)
    except (
        resources.IndexedSubsetRuntimeError,
        resources.ReferenceResourceError,
    ) as exc:
        raise WorkflowError(str(exc))
    # Defence in depth for a direct `snakemake` run (#292): a carried Column Map
    # is re-hashed against its binding before any build reads it.
    try:
        resources.verify_column_maps_for_releases(scheduled, registry_root=REGISTRY_ROOT)
    except resources.ReferenceResourceError as exc:
        raise WorkflowError(str(exc))
    # Defence in depth for a direct `snakemake` run (#306): a release that
    # completes its own Store gates its swap on the Observed-View Check, which
    # the resolved runtime must provide.
    try:
        resources.verify_observed_view_check_for_releases(scheduled, registry_root=REGISTRY_ROOT)
    except resources.ObservedViewCheckRuntimeError as exc:
        raise WorkflowError(str(exc))


# `all` is every bundle the contract lets this workflow build, not every
# registered one: any whose Release Status does not allow a build is left out
# (#247). Named on its own, such a bundle is refused at `onstart`.
BUILDABLE_STORE_IDS: list[str] = [sid for sid in ALL_STORE_IDS if bundle.is_buildable(get_bundle(sid))]


# A release is done when its last phase's register record exists: a release
# that completes its own Store has two (ADR 0037).
rule all:
    input:
        [record(sid, release_register(get_bundle(sid))) for sid in BUILDABLE_STORE_IDS]


def build_manifest_input(wildcards):
    """The bundle's analyses.tsv, its mtime ignored when it would change nothing.

    A fresh checkout gives every registry file a newer mtime than the Store
    published from it. A newer file with unchanged content is no reason to
    rerun (#339): when materialising the bundle would give the `work/` files
    already on disk, the input is `ancient`. The reverse is not decided here:
    a changed manifest is left to Snakemake's mtime, so a direct `snakemake`
    run misses one that is older than its outputs. The entry point
    (`release.stale_manifest_outputs`) forces those reruns itself.
    """
    source = get_bundle(wildcards.store_id).analyses_path
    if manifest.build_manifest_is_current(
        source,
        paths.build_manifest_path(wildcards.store_id, root=wildcards.root),
        paths.build_manifest_sidecar_path(wildcards.store_id, root=wildcards.root),
    ):
        return ancient(str(source))
    return str(source)


rule build_manifest:
    input:
        build_manifest_input
    output:
        manifest="{root}/{store_id}/work/analyses.tsv",
        sidecar="{root}/{store_id}/work/analyses.exclusions.json",
    run:
        manifest.materialise_build_manifest(
            Path(input[0]),
            Path(output.manifest),
            Path(output.sidecar),
        )


# A carried Column Map, staged under the artifact root where `plan()` names it
# for the build (`--column-map`), once its bytes match the Build Recipe's
# binding (#292). A refusal names the map.
rule column_map:
    input:
        lambda wildcards: str(
            Path(get_bundle(wildcards.store_id).root) / bundle.column_map_path(wildcards.file)
        )
    output:
        "{root}/{store_id}/work/column_maps/{file}"
    run:
        stage_column_map(wildcards.store_id, Path(output[0]))


rule step:
    input:
        step_input
    output:
        "{root}/{store_id}/records/{step}.json"
    run:
        step = next(
            s for s in get_steps(wildcards.store_id, wildcards.root)
            if s.name == wildcards.step
        )
        # A staged Column Map is up to date as far as Snakemake can tell, even
        # if it changed since: its bytes are checked here, before the step reads them.
        check_staged_column_map(wildcards.store_id, wildcards.root, step.inputs)
        run.run_step(
            step,
            store_id=wildcards.store_id,
            artifact_root=wildcards.root,
            resume=(step.name == "complete"),
        )


rule register:
    input:
        lambda wildcards: last_step_record(wildcards, BUILD_PHASE)
    output:
        "{root}/{store_id}/records/register.json"
    run:
        b = get_bundle(wildcards.store_id)
        # Inside the entry point's run, `release_run` names it. A published Store
        # is replaced only if it holds that run's records snapshot, which only
        # the entry point creates. The entry point also finishes the publication
        # (finalize=False): it removes publication.json once Snakemake has
        # recorded this job, so a crash before then is always recoverable (#195).
        release_run = config.get("release_run")
        forced = bool(
            run.forced_by_transaction(release_run, [(wildcards.root, wildcards.store_id)])
        )
        register.register_release(
            b,
            registry_root=REGISTRY_ROOT,
            artifact_root=wildcards.root,
            force=forced,
            publish=True,
            acceptance_commit=register.committed_revision(b.root / "validation.yaml"),
            finalize=not release_run,
        )


# The completion phase's register (ADR 0037): it replaces the Store the build
# phase's register published, through the same transaction, with no records
# snapshot, and deletes it. It needs no `force`; in a forced run it is passed
# one, and archives the Store instead, as every forced replacement does (#309).
# Under the entry point its marker is left for the entry point to remove, as
# every register job's is (#195).
rule completion_register:
    input:
        lambda wildcards: last_step_record(wildcards, COMPLETION_PHASE)
    output:
        "{root}/{store_id}/records/" + REGISTER_STEPS[COMPLETION_PHASE] + ".json"
    run:
        b = get_bundle(wildcards.store_id)
        release_run = config.get("release_run")
        register.register_release(
            b,
            registry_root=REGISTRY_ROOT,
            artifact_root=wildcards.root,
            force=register.forced_completion(release_run, wildcards.store_id, wildcards.root),
            publish=True,
            acceptance_commit=register.committed_revision(b.root / "validation.yaml"),
            finalize=not release_run,
            phase=COMPLETION_PHASE,
        )


# Target aliases, so an operator names a release rather than a path.
for sid in ALL_STORE_IDS:
    rule:
        name: sid
        input: record(sid, release_register(get_bundle(sid)))


def reject_unknown_store_id(wildcards):
    """Replace Snakemake's generic missing-rule error with registry guidance."""
    registered = ", ".join(ALL_STORE_IDS) or "(none)"
    raise WorkflowError(
        f"Unknown Store Release ID {wildcards.store_id!r}. Registered IDs: {registered}"
    )


rule unknown_store_release:
    input:
        reject_unknown_store_id
    output:
        "{store_id,OGS-[0-9]{5}}"


rule index:
    input:
        [str(REGISTRY_ROOT / sid / "release.yaml") for sid in ALL_STORE_IDS],
        [str(REGISTRY_ROOT / sid / "build.yaml") for sid in ALL_STORE_IDS],
        [str(REGISTRY_ROOT / sid / "analyses.tsv") for sid in ALL_STORE_IDS],
    run:
        index.generate_index(
            registry_root=REGISTRY_ROOT,
            repo_root=Path(workflow.basedir).parent if hasattr(workflow, "basedir") else Path.cwd(),
            artifact_root=config.get("artifact_root"),
        )
